  "rules": [
    {
      "id": "buff_1",
      "name": "BUFF 技能 1",
      "enabled": true,
      "priority": "P3_BUFF",
      "detect": { "kind": "none" },
      "trigger": { "mode": "timer", "periodMs": 300000, "jitterPct": 0.12 },
      "guard": { "scene": ["field"], "requireDialogFree": true },
      "actions": [ { "type": "key", "key": "skills.1", "waitAfterMs": 900 } ],
      "verify": { "expect": { "kind": "none" }, "timeoutMs": 0, "retry": 0 },
      "onFail": { "action": "alert", "alert": "BUFF1 动作异常" },
      "note": "detect/verify 的 kind 改为 buffSlot 并补模板即可启用视觉确认，代码无需改动。"
    },
    {
      "id": "buff_2",
      "name": "BUFF 技能 2",
      "enabled": false,
      "priority": "P3_BUFF",
      "detect": { "kind": "none" },
      "trigger": { "mode": "timer", "periodMs": 300000, "jitterPct": 0.12 },
      "guard": { "scene": ["field"], "requireDialogFree": true },
      "actions": [ { "type": "key", "key": "skills.2", "waitAfterMs": 900 } ],
      "verify": { "expect": { "kind": "none" }, "timeoutMs": 0, "retry": 0 },
      "onFail": { "action": "alert", "alert": "BUFF2 动作异常" }
    },
    {
      "id": "buff_3",
      "name": "BUFF 技能 3",
      "enabled": false,
      "priority": "P3_BUFF",
      "detect": { "kind": "none" },
      "trigger": { "mode": "timer", "periodMs": 300000, "jitterPct": 0.12 },
      "guard": { "scene": ["field"], "requireDialogFree": true },
      "actions": [ { "type": "key", "key": "skills.3", "waitAfterMs": 900 } ],
      "verify": { "expect": { "kind": "none" }, "timeoutMs": 0, "retry": 0 },
      "onFail": { "action": "alert", "alert": "BUFF3 动作异常" }
    },
    {
      "id": "death_watch",
      "name": "角色死亡检测（HP 归零 / 血条消失）",
      "enabled": true,
      "priority": "P0_EMERGENCY",
      "detect": {
        "kind": "hpBarFill",
        "roi": [0.4289, 0.8958, 0.5711, 0.9125],
        "hpBelowPct": 5,
        "alsoTriggerIfBarMissing": true,
        "confirmFrames": 3
      },
      "trigger": { "mode": "onPresent", "minIntervalMs": 3000, "cooldownMs": 30000 },
      "guard": { "scene": ["freeMarket", "field", "unknown"] },
      "actions": [
        { "type": "pause", "message": "检测到角色死亡或血量归零，停止所有操作" },
        { "type": "alert", "level": "FATAL", "message": "角色疑似死亡（HP<5% 或血条消失），已全局暂停。请人工处理复活。" }
      ],
      "verify": { "expect": { "kind": "always" }, "timeoutMs": 0, "retry": 0 },
      "onFail": { "action": "alert", "alert": "死亡检测告警" },
      "note": "不做自动复活——复活流程未知且可能涉及消费确认，风险不对等。"
    },

    {
      "id": "dialog_notice",
      "name": "公告弹窗",
      "enabled": true,
      "priority": "P0_EMERGENCY",
      "detect": { "kind": "template", "template": "dialog_notice", "roi": [0.15,0.15,0.85,0.85], "threshold": 0.86, "confirmFrames": 2 },
      "trigger": { "mode": "onPresent", "minIntervalMs": 5000, "cooldownMs": 8000 },
      "guard": { "scene": ["dialog"] },
      "actions": [ { "type": "key", "key": "cancel", "waitAfterMs": 800 } ],
      "verify": { "expect": { "kind": "templateGone", "template": "dialog_notice", "roi": [0.15,0.15,0.85,0.85], "threshold": 0.86 }, "timeoutMs": 3000, "retry": 1 },
      "onFail": { "action": "pauseAndAlert", "alert": "公告弹窗关不掉，已暂停" }
    },
    {
      "id": "dialog_update",
      "name": "更新提示",
      "enabled": true,
      "priority": "P0_EMERGENCY",
      "detect": { "kind": "template", "template": "dialog_update", "roi": [0.15,0.15,0.85,0.85], "threshold": 0.86, "confirmFrames": 2 },
      "trigger": { "mode": "onPresent", "minIntervalMs": 5000, "cooldownMs": 30000 },
      "guard": { "scene": ["dialog", "unknown"] },
      "actions": [
        { "type": "alert", "level": "FATAL", "message": "游戏/平台更新提示，模板可能全部失效，已暂停" },
        { "type": "pause", "message": "更新提示：不自动更新，等待重新标定" }
      ],
      "verify": { "expect": { "kind": "always" }, "timeoutMs": 0, "retry": 0 },
      "onFail": { "action": "alert", "alert": "更新弹窗告警" }
    },
    {
      "id": "dialog_purchase",
      "name": "消费确认弹窗（红线）",
      "enabled": true,
      "priority": "P0_EMERGENCY",
      "detect": { "kind": "template", "template": "dialog_purchase", "roi": [0.15,0.15,0.85,0.85], "threshold": 0.82, "confirmFrames": 2 },
      "trigger": { "mode": "onPresent", "minIntervalMs": 5000, "cooldownMs": 30000 },
      "guard": { "scene": ["dialog", "freeMarket", "field", "unknown"] },
      "actions": [
        { "type": "pause", "message": "检测到消费确认弹窗，立即停止所有操作" },
        { "type": "alert", "level": "FATAL", "message": "【红线】检测到消费/充值确认弹窗，已全局暂停。请人工检查！" }
      ],
      "verify": { "expect": { "kind": "always" }, "timeoutMs": 0, "retry": 0 },
      "onFail": { "action": "alert", "alert": "消费弹窗红线告警" }
    }
  ],

  "macros": {
    "macro_wait_and_stroll": {
      "name": "野外原地走动等待（简易模式）",
      "timeoutMs": 300000,
      "retry": 0,
      "onFail": "alertAndPause",
      "steps": [
        { "type": "assertScene", "scene": "field", "timeoutMs": 5000, "onFail": "alertAndPause" },
        {
          "type": "walkRange",
          "axis": "x",
          "mode": "keyRepeat",
          "from": [0.45, 0.55],
          "to":   [0.55, 0.55],
          "until": { "kind": "scheduleDue" },
          "tolerance": 0.030,
          "stepRepeatCount": 3,
          "maxIterationsPerLeg": 25,
          "pauseBetweenMs": [1200, 3500],
          "onStuck": { "action": "nudgeRandom", "retry": 3, "thenAlert": "野外原地走动卡住" }
        }
      ]
    },

    "macro_wait_in_market": {
      "name": "自由市场内走动等待",
      "timeoutMs": 300000,
      "retry": 0,
      "onFail": "alertAndPause",
      "steps": [
        { "type": "assertScene", "scene": "freeMarket", "timeoutMs": 5000, "onFail": "alertAndPause" },
        {
          "type": "walkRange",
          "axis": "x",
          "mode": "keyRepeat",
          "from": [0.30, 0.55],
          "to":   [0.45, 0.55],
          "until": { "kind": "scheduleDue" },
          "tolerance": 0.025,
          "stepRepeatCount": 3,
          "maxIterationsPerLeg": 25,
          "pauseBetweenMs": [800, 2500],
          "onStuck": { "action": "nudgeRandom", "retry": 3, "thenAlert": "自由市场走动卡住" }
        }
      ]
    },

    "macro_exit_market": {
      "name": "离开自由市场（走到传送门 + 按方向键上）",
      "timeoutMs": 60000,
      "retry": 1,
      "onFail": "alertAndPause",
      "steps": [
        { "type": "assertScene", "scene": "freeMarket", "timeoutMs": 5000 },
        {
          "type": "walkTo",
          "mode": "keyRepeat",
          "axis": "x",
          "locateSelf": "headHpBar",
          "locateTarget": "portalMarker",
          "targetRef": "portal_in_market",
          "tolerance": 0.030,
          "stepRepeatCount": 3,
          "maxIterations": 30,
          "onStuck": { "action": "nudgeRandom", "retry": 3 }
        },
        { "type": "key", "key": "move.up", "waitAfterMs": 800,
          "note": "用户确认：走到传送门后按方向键上回到原来的地图" },
        { "type": "waitScene", "scene": "loading", "timeoutMs": 8000, "onFail": "retry" },
        { "type": "waitSceneGone", "scene": "loading", "timeoutMs": 30000 },
        { "type": "assertScene", "scene": "field", "timeoutMs": 15000, "onFail": "alertAndPause" }
      ]
    },

    "macro_cast_buffs": {
      "name": "逐个释放 BUFF",
      "timeoutMs": 30000,
      "retry": 1,
      "onFail": "alertAndPause",
      "steps": [
        { "type": "assertScene", "scene": "field", "timeoutMs": 8000, "onFail": "alertAndPause" },
        { "type": "wait", "durationMs": 1200, "jitterMs": 600 },
        { "type": "runRule", "ruleId": "buff_1" },
        { "type": "wait", "durationMs": 900, "jitterMs": 400 },
        { "type": "runRule", "ruleId": "buff_2" },
        { "type": "wait", "durationMs": 900, "jitterMs": 400 },
        { "type": "runRule", "ruleId": "buff_3" }
      ],
      "note": "buff_2/buff_3 enabled=false 时自动跳过。技能间强制 ≥0.9s 间隔。"
    },

    "macro_return_market": {
      "name": "返回自由市场（菜单 → 自由市场按键）",
      "timeoutMs": 90000,
      "retry": 1,
      "onFail": "alertAndPause",
      "steps": [
        { "type": "assertScene", "scene": "field", "timeoutMs": 8000, "onFail": "alertAndPause" },
        { "type": "key", "key": "menuOpen", "waitAfterMs": 900,
          "note": "Q-07 待确认：菜单怎么打开（快捷键还是屏幕坐标）" },
        { "type": "assertMenuOpen", "timeoutMs": 3000, "onFail": "retry",
          "note": "用全屏亮度骤降判定菜单已打开" },
        { "type": "tap", "target": "menu_free_market", "jitter": 0.003, "waitAfterMs": 900,
          "note": "菜单中的『自由市场』按键，坐标待标定" },
        { "type": "waitScene", "scene": "loading", "timeoutMs": 8000, "onFail": "retry" },
        { "type": "waitSceneGone", "scene": "loading", "timeoutMs": 30000 },
        { "type": "assertScene", "scene": "freeMarket", "timeoutMs": 20000, "onFail": "alertAndPause" }
      ]
    }
  },

  "schedule": {
    "mode": "loop",
    "waitLocation": "inPlace",
    "_waitLocation_options": {
      "inPlace": "简易模式：全程待在野外，原地走动，到点原地加 BUFF（推荐先做，无地图切换风险）",
      "freeMarket": "回城模式：自由市场等待 → 传送门 → 方向键上出去 → 加 BUFF → 菜单回自由市场"
    },
    "anchor": "afterCast",
    "_anchor_options": {
      "afterCast": "从上一次释放 BUFF 起算（推荐，间隔最稳定）",
