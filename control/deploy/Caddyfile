# 阿尔泰集控 —— Caddy 反代 + 自动 HTTPS
#
# 把 control.example.com 换成你自己的域名（DNS 必须已解析到这台机器）。
# Caddy 会全自动申请并续期 Let's Encrypt 证书，不需要手动碰证书文件。

control.example.com {
	encode zstd gzip

	# 全部请求（面板静态页 + /api）都交给 altaird，同源，所以不需要任何 CORS 配置
	reverse_proxy 127.0.0.1:8788 {
		# ★ SSE（/api/v1/panel/events）必须关掉缓冲，否则实时推送会被攒着不发
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output file /var/log/caddy/altair.log
		format json
	}
}
