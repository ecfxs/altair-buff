{
  "name": "@altair/control-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "阿尔泰挂机 · 集控监控台前端（Vite + React + TS + Tailwind v4）",
  "scripts": {
    "dev": "vite",
    "gen": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm gen && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
